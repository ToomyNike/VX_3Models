page {
  min-height: 100vh;
  background: #f4f7f3;
  color: #1d2a22;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

.section-title {
  margin: 12rpx 0 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #68756c;
  font-size: 26rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #dfe7df;
  border-radius: 8rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item,
.grid-2 .field,
.grid-2 button {
  width: 48%;
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 84rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.primary-btn {
  background: #1f5a3a;
  color: #ffffff;
}

.ghost-btn {
  background: #ffffff;
  color: #1f5a3a;
  border: 1rpx solid #b9cdbf;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #46554b;
  font-size: 26rpx;
}

.input,
.picker {
  width: 100%;
  min-height: 76rpx;
  border: 1rpx solid #cfd9d1;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.textarea {
  min-height: 150rpx;
  padding-top: 16rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
}
