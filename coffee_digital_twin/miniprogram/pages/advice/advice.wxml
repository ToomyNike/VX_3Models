<view class="page">
  <view class="section">
    <view class="section-title">AI农技建议</view>
    <view class="muted">what / how / why 三段式输出</view>
  </view>

  <loading-panel wx:if="{{loading}}" text="生成农技建议"></loading-panel>

  <block wx:else>
    <view class="advice-card">
      <view class="label">What</view>
      <view class="content">{{advice.what}}</view>
    </view>
    <view class="advice-card">
      <view class="label">How</view>
      <view class="content">{{advice.how}}</view>
    </view>
    <view class="advice-card">
      <view class="label">Why</view>
      <view class="content">{{advice.why}}</view>
    </view>
  </block>
</view>
