<view class="page">
  <view class="section">
    <view class="section-title">农事打卡</view>
    <view class="muted">打卡数据会写入 Flask，并转成模型管理事件</view>
  </view>

  <form bindsubmit="submit">
    <view class="panel">
      <view class="field">
        <text class="field-label">农事类型</text>
        <picker range="{{opTypes}}" range-key="label" value="{{opIndex}}" bindchange="changeOp">
          <view class="picker">{{opTypes[opIndex].label}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">日期</text>
        <input class="input" name="date" value="{{today}}" />
      </view>

      <block wx:if="{{opValue == 'irrigation'}}">
        <view class="grid-2">
          <view class="field">
            <text class="field-label">灌溉量</text>
            <input class="input" name="amount" type="digit" value="25" />
          </view>
          <view class="field">
            <text class="field-label">单位</text>
            <input class="input" name="unit" value="mm" />
          </view>
        </view>
      </block>

      <block wx:elif="{{opValue == 'fertilization'}}">
        <view class="field">
          <text class="field-label">肥料类型</text>
          <input class="input" name="fertilizer_type" value="尿素" />
        </view>
        <view class="grid-2">
          <view class="field">
            <text class="field-label">施肥量</text>
            <input class="input" name="amount" type="digit" value="10" />
          </view>
          <view class="field">
            <text class="field-label">单位</text>
            <input class="input" name="unit" value="kg/mu" />
          </view>
        </view>
      </block>

      <block wx:elif="{{opValue == 'canopy_management'}}">
        <view class="field">
          <text class="field-label">操作类型</text>
          <input class="input" name="operation_type" value="修剪" />
        </view>
        <view class="field">
          <text class="field-label">操作强度</text>
          <input class="input" name="severity" value="轻度" />
        </view>
      </block>

      <block wx:else>
        <view class="field">
          <text class="field-label">异常类型</text>
          <input class="input" name="operation_type" value="病虫害" />
        </view>
        <view class="field">
          <text class="field-label">严重程度</text>
          <input class="input" name="severity" value="轻微" />
        </view>
      </block>

      <view class="field">
        <text class="field-label">备注</text>
        <textarea class="input textarea" name="remark" placeholder="可选"></textarea>
      </view>
    </view>

    <button class="primary-btn submit" form-type="submit" loading="{{saving}}">保存打卡</button>
  </form>
</view>
